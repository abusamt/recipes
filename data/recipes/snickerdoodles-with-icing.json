  "ingredients": [
    {
      "type": "item",
      "text": "125g cake flour + 120g ap + 125g bread flour"
    },
    {
      "type": "item",
      "text": "7g cream of tartar"
    },
    {
      "type": "item",
      "text": "5g baking soda"
    },
    {
      "type": "item",
      "text": "2g baking powder - or a big pinch, half teaspoon"
    },
    {
      "type": "item",
      "text": "1/2 tsp kosher salt"
    },
    {
      "type": "item",
      "text": "300g granulated sugar + molasses (try 200-250g)"
    },
    {
      "type": "item",
      "text": "1/2 cup unsalted butter at room temperature"
    },
    {
      "type": "item",
      "text": "1/2 cup butter flavored shortening"
    },
    {
      "type": "item",
      "text": "1 large egg"
    },
    {
      "type": "item",
      "text": "1 egg yolk"
    },
    {
      "type": "item",
      "text": "1 1/2 teaspoons vanilla extract"
    },
    {
      "type": "item",
      "text": "some cinnamon"
    },
    {
      "type": "heading",
      "text": "Cinnamon Sugar Topping:"
    },
    {
      "type": "item",
      "text": "3 tablespoons granulated sugar"
    },
    {
      "type": "item",
      "text": "3 teaspoons ground cinnamon"
    },
    {
      "type": "item",
      "text": "2 tablespoons turbinado sugar"
    },
    {
      "type": "item",
      "text": "OVEN: 350"
    },
    {
      "type": "item",
      "text": "TIME: 8-10 mins"
    },
    {
      "type": "item",
      "text": "Icing"
    },
    {
      "type": "item",
      "text": "~250g powdered sugar"
    },
    {
      "type": "item",
      "text": "~1/2 vanillin sugar packet"
    },
    {
      "type": "item",
      "text": "~Tbs corn syrup"
    },
    {
      "type": "item",
      "text": "-as much cream as needed"
    },
    {
      "type": "item",
      "text": "-pinch of salt"
    }
  ],
  "instructions": [
    {
      "type": "step",
      "text": "combine dry ingredients + cinnamon\nwhisk\ncombine (mixer) sugar with butter + molasses\nadd egg + egg yolk\nadd vanilla\nadd dry to wet and mix until combined\nchill in fridge\nroll into balls\ncoat with topping\nbake ~10 minutes\ncool\nicing"
    }
  ],
