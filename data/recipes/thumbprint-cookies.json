  "ingredients": [
    {
      "type": "item",
      "text": "1 stick (1/2 cup) soft unsalted butter"
    },
    {
      "type": "item",
      "text": "1/3 cup powdered sugar (not sifted)"
    },
    {
      "type": "item",
      "text": "1 large egg yolk"
    },
    {
      "type": "item",
      "text": "1 teaspoon vanilla extract"
    },
    {
      "type": "item",
      "text": "1/4 teaspoon fine salt"
    },
    {
      "type": "item",
      "text": "1 1/4 cups all-purpose flour (5 ounces by weight)"
    },
    {
      "type": "item",
      "text": "1/2 cup fruit jam to fill centers"
    },
    {
      "type": "item",
      "text": "325 F. for 15 minutes"
    }
  ],
  "instructions": [
    {
      "type": "step",
      "text": "Combine powdered sugar with a little milk or water, and mix until you have a consistency that will hold its shape when piped."
    }
