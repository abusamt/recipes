    {
      "type": "item",
      "text": "1 teaspoon of baking soda (5g)"
    },
    {
      "type": "item",
      "text": "2 eggs (Room Temperature)"
    },
    {
      "type": "item",
      "text": "1 cup of milk/buttermilk (240ml)"
    },
    {
      "type": "item",
      "text": "2 tablespoons of melted butter (28g)"
    },
    {
      "type": "item",
      "text": "1 teaspoon of vanilla extract (5ml)"
    }
