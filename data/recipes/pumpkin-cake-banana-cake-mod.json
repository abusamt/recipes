  "instructions": [
    {
      "type": "step",
      "text": "Cream together shortening, browned slightly firmed butter, sugar, & molasses blending well."
    },
    {
      "type": "step",
      "text": "Add well beaten eggs and pumpkin, beat well"
    },
    {
      "type": "step",
      "text": "Sift flours then resift with dry ingredients (salt, b soda, b powder, cinnamon, nutmeg, ginger, salt)"
    },
    {
      "type": "step",
      "text": "Add dry alternatively with wet mixture of buttermilk combined"
    },
    {
      "type": "step",
      "text": "In greased, floured pans bake at 350F for about 5-7 minutes, then REDUCE temp to 330-345 for 5 minutes, then reduce more if needed for rest of cooking time (about 25-35 minutes)"
    },
    {
      "type": "step",
      "text": "Internal temp should be about 190F-200F (closer to 190F)"
    },
    {
      "type": "step",
      "text": "Let cool"
    },
    {
      "type": "heading",
      "text": "For Frosting:"
    },
    {
      "type": "step",
      "text": "Cream all ingredients together"
    },
    {
      "type": "step",
      "text": "Spread onto cooled cake or leave separate for individual slices"
    }
