  "image": "images/oil_gummies_pectin_and_gelatin_6d81v.jpg",
  "servings": "180-200 lil cubes, or 45-50 mold-sized squares",
  "categories": [],
  "ingredients": [
    {
      "type": "item",
      "text": "160g coconut oil"
    },
    {
      "type": "item",
      "text": "150g sugar + 100g water + 100g corn syrup"
    },
    {
      "type": "item",
      "text": "35g gelatin + 160g juice"
    },
    {
      "type": "item",
      "text": "1TBSP lecithin"
    },
    {
      "type": "item",
      "text": "10g pectin"
    },
    {
      "type": "item",
      "text": "1/3tsp potassium sorbate"
    },
    {
      "type": "item",
      "text": "100g gelatin"
    },
    {
      "type": "item",
      "text": "1 dram bottle flavouring oil"
    }
  ],
  "instructions": [
    {
      "type": "step",
      "text": "bloom 160g juice with 35g gelatin"
    },
    {
      "type": "step",
      "text": "boil to 220-250F: 150g sugar + 90g water + 100g corn syrup"
    },
    {
      "type": "step",
      "text": "let syrup coil to 200F"
    },
    {
      "type": "step",
      "text": "add 10g of pectin, 1/3tsp potassium sorbate, stir out clumps"
    },
    {
      "type": "step",
      "text": "add 100g of gelatin, stirring out clumps"
    },
    {
      "type": "step",
      "text": "add bloomed gelatin, lecithin"
    },
    {
      "type": "step",
      "text": "add oil"
    },
    {
      "type": "step",
      "text": "add flavouring oil"
    },
    {
      "type": "step",
      "text": "whisk on low heat, consistently, until mixed and emulsified. fold edges into center as stirring"
    }
  ],
  "notes": [],
  "extra": ""
}
